{
  "cases": [
    {
      "name": "van 4",
      "sha256": "d534f88a057dbf914c1a1d6548cf0d117b3195b934717197ac6b363ddab260a5",
      "cues": [
        {
          "id": 1,
          "timecode": "00:00:00,000 --> 00:00:03,400",
          "text": "He bought a six-foot bologna log. His plan was even bigger."
        },
        {
          "id": 2,
          "timecode": "00:00:03,400 --> 00:00:06,800",
          "text": "Vance wanted to beat the price of ordinary store sandwiches."
        },
        {
          "id": 3,
          "timecode": "00:00:06,800 --> 00:00:10,200",
          "text": "Buying that many packaged sandwiches would cost over twelve hundred dollars."
        },
        {
          "id": 4,
          "timecode": "00:00:10,200 --> 00:00:13,600",
          "text": "His homemade version came to just three hundred thirty-two dollars."
        },
        {
          "id": 5,
          "timecode": "00:00:13,600 --> 00:00:17,000",
          "text": "The enormous bologna looked more like a fence post than lunch."
        },
        {
          "id": 6,
          "timecode": "00:00:17,000 --> 00:00:20,400",
          "text": "Suddenly, Vance's quiet kitchen looked like a busy sandwich shop."
        },
        {
          "id": 7,
          "timecode": "00:00:20,400 --> 00:00:23,800",
          "text": "Store sandwiches often come with barely any fresh vegetables inside."
        },
        {
          "id": 8,
          "timecode": "00:00:23,800 --> 00:00:27,200",
          "text": "Vance wanted every bite to feel like a proper meal."
        },
        {
          "id": 9,
          "timecode": "00:00:27,200 --> 00:00:30,600",
          "text": "But plain meat and bread weren't going to impress anybody."
        },
        {
          "id": 10,
          "timecode": "00:00:30,600 --> 00:00:34,000",
          "text": "Then his giant pot appeared, and the challenge got serious."
        },
        {
          "id": 11,
          "timecode": "00:00:34,000 --> 00:00:37,400",
          "text": "Sweet onions slowly turned golden as the whole kitchen filled with aroma."
        },
        {
          "id": 12,
          "timecode": "00:00:37,400 --> 00:00:40,800",
          "text": "Even Vance looked surprised by how delicious everything suddenly smelled."
        },
        {
          "id": 13,
          "timecode": "00:00:40,800 --> 00:00:44,200",
          "text": "Next came a mountain of cheese that seemed impossible to finish."
        },
        {
          "id": 14,
          "timecode": "00:00:44,200 --> 00:00:47,600",
          "text": "The deli slicer made his giant sandwich dream feel real."
        },
        {
          "id": 15,
          "timecode": "00:00:47,600 --> 00:00:51,000",
          "text": "Then Vance revealed the ingredient nobody expected in this sandwich marathon."
        },
        {
          "id": 16,
          "timecode": "00:00:51,000 --> 00:00:54,400",
          "text": "An unbelievable number of eggs covered the wide metal griddle."
        },
        {
          "id": 17,
          "timecode": "00:00:54,400 --> 00:00:57,800",
          "text": "He laid out twenty-eight bread slices at once for the crowd."
        },
        {
          "id": 18,
          "timecode": "00:00:57,800 --> 00:01:01,200",
          "text": "That tiny kitchen toaster never stood a chance against this plan."
        },
        {
          "id": 19,
          "timecode": "00:01:01,200 --> 00:01:04,600",
          "text": "With the bread perfectly toasted, the real mountain began rising."
        },
        {
          "id": 20,
          "timecode": "00:01:04,600 --> 00:01:08,000",
          "text": "Soon the dining table disappeared beneath an enormous wall of sandwiches."
        },
        {
          "id": 21,
          "timecode": "00:01:08,000 --> 00:01:11,400",
          "text": "Hundreds of towering sandwiches stood in rows across the table."
        },
        {
          "id": 22,
          "timecode": "00:01:11,400 --> 00:01:14,900",
          "text": "Each one held eggs, onions, cheese, and plenty of filling."
        },
        {
          "id": 23,
          "timecode": "00:01:14,900 --> 00:01:18,300",
          "text": "But Vance wasn't making all this food for himself."
        },
        {
          "id": 24,
          "timecode": "00:01:18,300 --> 00:01:21,800",
          "text": "After dark, yellow crates packed with sandwiches filled the station wagon."
        },
        {
          "id": 25,
          "timecode": "00:01:21,800 --> 00:01:25,200",
          "text": "The real destination was a community room filled with children."
        },
        {
          "id": 26,
          "timecode": "00:01:25,200 --> 00:01:28,600",
          "text": "One ordinary evening suddenly became a huge neighborhood dinner."
        },
        {
          "id": 27,
          "timecode": "00:01:28,600 --> 00:01:32,000",
          "text": "The best part wasn't the massive pile of homemade sandwiches."
        },
        {
          "id": 28,
          "timecode": "00:01:32,000 --> 00:01:35,495",
          "text": "It was watching everyone smile when they finally shared them."
        }
      ],
