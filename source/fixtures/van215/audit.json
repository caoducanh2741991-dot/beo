    {
      "name": "van 5",
      "sha256": "7abd139b699b65dfe5c0cdfaed5d89e5d4c4bdbebdf8403bebd247e89c26d373",
      "cues": [
        {
          "id": 1,
          "timecode": "00:00:00,000 --> 00:00:03,500",
          "text": "Could your old school lunch beat meals from nine other countries?"
        },
        {
          "id": 2,
          "timecode": "00:00:03,500 --> 00:00:07,000",
          "text": "Vance brought two friends to settle that question once and for all."
        },
        {
          "id": 3,
          "timecode": "00:00:07,000 --> 00:00:10,400",
          "text": "Ten different school lunch trays entered their homemade food showdown."
        },
        {
          "id": 4,
          "timecode": "00:00:10,400 --> 00:00:13,900",
          "text": "And these three grown men were taking every bite seriously."
        },
        {
          "id": 5,
          "timecode": "00:00:13,900 --> 00:00:17,400",
          "text": "Taste, nutrition, and fullness would decide the winning country."
        },
        {
          "id": 6,
          "timecode": "00:00:17,400 --> 00:00:20,900",
          "text": "Only one tray could claim the title of school lunch champion."
        },
        {
          "id": 7,
          "timecode": "00:00:20,900 --> 00:00:24,300",
          "text": "They started with an American tray priced at two fifty."
        },
        {
          "id": 8,
          "timecode": "00:00:24,300 --> 00:00:27,800",
          "text": "It had a burger, fries, a donut, and a soda."
        },
        {
          "id": 9,
          "timecode": "00:00:27,800 --> 00:00:31,300",
          "text": "A donut and soda for lunch? That sparked instant debate."
        },
        {
          "id": 10,
          "timecode": "00:00:31,300 --> 00:00:34,800",
          "text": "Nobody could decide if this was lunch or a party."
        },
        {
          "id": 11,
          "timecode": "00:00:34,800 --> 00:00:38,200",
          "text": "Vance loved the burger and fries more than he expected."
        },
        {
          "id": 12,
          "timecode": "00:00:38,200 --> 00:00:41,700",
          "text": "Comfort food was clearly winning this first round on taste."
        },
        {
          "id": 13,
          "timecode": "00:00:41,700 --> 00:00:45,200",
          "text": "Milo and Zack finished their trays and joined the judging."
        },
        {
          "id": 14,
          "timecode": "00:00:45,200 --> 00:00:48,700",
          "text": "America scored well for flavor, but only four for health."
        },
        {
          "id": 15,
          "timecode": "00:00:48,700 --> 00:00:52,100",
          "text": "Japan's tray changed the mood as soon as it appeared."
        },
        {
          "id": 16,
          "timecode": "00:00:52,100 --> 00:00:55,600",
          "text": "Fish, vegetables, and fruit offered a completely different kind of lunch."
        },
        {
          "id": 17,
          "timecode": "00:00:55,600 --> 00:00:59,100",
          "text": "The guys struggled with chopsticks, then washed everything down with milk."
        },
        {
          "id": 18,
          "timecode": "00:00:59,100 --> 00:01:02,600",
          "text": "Japan walked away with seventy-one points on their scoreboard."
        },
        {
          "id": 19,
          "timecode": "00:01:02,600 --> 00:01:06,000",
          "text": "Then India arrived with a price that surprised everyone."
        },
        {
          "id": 20,
          "timecode": "00:01:06,000 --> 00:01:09,500",
          "text": "Warm lentils, vegetables, flatbread, and chai filled the colorful tray."
        },
        {
          "id": 21,
          "timecode": "00:01:09,500 --> 00:01:13,000",
          "text": "They listed this hearty school meal at absolutely no charge."
        },
        {
          "id": 22,
          "timecode": "00:01:13,000 --> 00:01:16,500",
          "text": "That alone impressed the judges before Italy even took the stage."
        },
        {
          "id": 23,
          "timecode": "00:01:16,500 --> 00:01:19,900",
          "text": "Italy's tray looked more like dinner at a family restaurant."
        },
        {
          "id": 24,
          "timecode": "00:01:19,900 --> 00:01:23,400",
          "text": "Pasta, pizza, salad, and grapes made everyone lean forward."
        },
        {
          "id": 25,
          "timecode": "00:01:23,400 --> 00:01:26,900",
          "text": "Vance joked that he would never skip school for pizza."
        },
        {
          "id": 26,
          "timecode": "00:01:26,900 --> 00:01:30,400",
          "text": "He looked ready to give the Italian tray a trophy."
        },
        {
          "id": 27,
          "timecode": "00:01:30,400 --> 00:01:33,800",
          "text": "But first, the judges finally finished calculating India's total."
        },
        {
          "id": 28,
          "timecode": "00:01:33,800 --> 00:01:37,300",
          "text": "India earned fifty points, with fullness helping its score."
        },
        {
          "id": 29,
          "timecode": "00:01:37,300 --> 00:01:40,800",
          "text": "Italy still looked tempting, but its final score could wait."
        },
        {
          "id": 30,
          "timecode": "00:01:40,800 --> 00:01:44,300",
          "text": "Now Ukraine brought a comforting, home-style tray to the table."
        },
        {
          "id": 31,
          "timecode": "00:01:44,300 --> 00:01:47,700",
          "text": "Buckwheat and a savory cutlet were the stars of this meal."
        },
        {
          "id": 32,
          "timecode": "00:01:47,700 --> 00:01:51,200",
          "text": "Cabbage salad, cheesy bread, and fruit compote rounded it out."
        },
        {
          "id": 33,
          "timecode": "00:01:51,200 --> 00:01:54,700",
          "text": "It wasn't flashy, but the judges immediately understood its appeal."
        },
        {
          "id": 34,
          "timecode": "00:01:54,700 --> 00:01:58,200",
          "text": "This was exactly the kind of meal that actually fills you."
        },
        {
          "id": 35,
          "timecode": "00:01:58,200 --> 00:02:01,600",
          "text": "All three plates were cleared before anyone could say another word."
        },
        {
          "id": 36,
          "timecode": "00:02:01,600 --> 00:02:05,100",
          "text": "Ukraine surged into the lead with seventy-five total points."
        },
        {
          "id": 37,
          "timecode": "00:02:05,100 --> 00:02:08,600",
          "text": "Mexico arrived next, bringing an entirely different lunchtime energy."
        },
        {
          "id": 38,
          "timecode": "00:02:08,600 --> 00:02:12,100",
          "text": "The tray paired a casserole with a generously filled taco."
        },
        {
          "id": 39,
          "timecode": "00:02:12,100 --> 00:02:15,600",
          "text": "Chips, guacamole, and chocolate milk made the deal even sweeter."
        },
        {
          "id": 40,
          "timecode": "00:02:15,600 --> 00:02:19,100",
          "text": "And the listed price was just one dollar for everything."
        },
        {
          "id": 41,
          "timecode": "00:02:19,100 --> 00:02:22,600",
          "text": "Vance gave the flavor a perfect ten without hesitation."
        },
        {
          "id": 42,
          "timecode": "00:02:22,600 --> 00:02:26,100",
          "text": "But nutrition pulled Mexico's overall score down to sixty."
        },
        {
          "id": 43,
          "timecode": "00:02:26,100 --> 00:02:29,600",
          "text": "Brazil answered with one of the freshest looking trays yet."
        },
        {
          "id": 44,
          "timecode": "00:02:29,600 --> 00:02:33,100",
          "text": "Seasoned grains, a green wrap, fruit, and mango juice stood out."
        },
        {
          "id": 45,
          "timecode": "00:02:33,100 --> 00:02:36,600",
          "text": "That huge green wrap almost looked bigger than a textbook."
        },
        {
          "id": 46,
          "timecode": "00:02:36,600 --> 00:02:40,100",
          "text": "The judges needed both hands just to hold each bite."
        },
        {
          "id": 47,
          "timecode": "00:02:40,100 --> 00:02:43,600",
          "text": "Brazil scored a perfect thirty for their health category."
        },
        {
          "id": 48,
          "timecode": "00:02:43,600 --> 00:02:47,100",
          "text": "That pushed its total to seventy-five, tying Ukraine."
        },
        {
          "id": 49,
          "timecode": "00:02:47,100 --> 00:02:50,600",
          "text": "Next, China's colorful tray gave the judges even more choices."
        },
        {
          "id": 50,
          "timecode": "00:02:50,600 --> 00:02:54,100",
          "text": "Rice, savory meat, and dumplings immediately caught everyone's attention."
        },
        {
          "id": 51,
          "timecode": "00:02:54,100 --> 00:02:57,600",
          "text": "Braised greens, an egg, and orange slices completed the spread."
        },
        {
          "id": 52,
          "timecode": "00:02:57,600 --> 00:03:01,100",
          "text": "Suddenly, this felt more like a weekend feast than school lunch."
        },
        {
          "id": 53,
          "timecode": "00:03:01,100 --> 00:03:04,600",
          "text": "Their chopstick skills were shaky, but the dumplings disappeared fast."
        },
        {
          "id": 54,
          "timecode": "00:03:04,600 --> 00:03:08,100",
          "text": "China collected sixty-nine points after everyone finished eating."
        },
        {
          "id": 55,
          "timecode": "00:03:08,100 --> 00:03:11,600",
          "text": "Spain was next with a colorful Mediterranean-inspired lunch tray."
        },
        {
          "id": 56,
          "timecode": "00:03:11,600 --> 00:03:15,100",
          "text": "Rice, cucumber salad, and fruit gave the meal a fresh look."
        },
        {
          "id": 57,
          "timecode": "00:03:15,100 --> 00:03:18,600",
          "text": "That little foil drink pouch brought back everyone's childhood memories."
        },
        {
          "id": 58,
          "timecode": "00:03:18,600 --> 00:03:22,100",
          "text": "Even the judges were smiling before the final scores appeared."
        },
        {
          "id": 59,
          "timecode": "00:03:22,100 --> 00:03:25,600",
          "text": "Spain took the lead with an impressive seventy-six points."
        },
        {
          "id": 60,
          "timecode": "00:03:25,600 --> 00:03:29,100",
          "text": "Only Turkey's tray and Italy's final score were still waiting."
        },
        {
          "id": 61,
          "timecode": "00:03:29,100 --> 00:03:32,600",
          "text": "Turkey served up a lunch that looked restaurant-worthy."
        },
        {
          "id": 62,
          "timecode": "00:03:32,600 --> 00:03:36,100",
          "text": "Grilled kebab, fresh herbs, and flatbread covered the tray."
        },
        {
          "id": 63,
          "timecode": "00:03:36,100 --> 00:03:39,600",
          "text": "Then baklava arrived, making dessert feel like a bonus round."
        },
        {
          "id": 64,
          "timecode": "00:03:39,600 --> 00:03:43,100",
          "text": "But the salted yogurt drink caught all three judges off guard."
        },
        {
          "id": 65,
          "timecode": "00:03:43,100 --> 00:03:46,600",
          "text": "The grilled food earned praise, while that drink divided opinions."
        },
        {
          "id": 66,
          "timecode": "00:03:46,600 --> 00:03:50,100",
          "text": "Nobody expected their first sip to taste quite that salty."
        },
        {
          "id": 67,
          "timecode": "00:03:50,100 --> 00:03:53,600",
          "text": "A perfect fullness score still gave Turkey sixty-two points overall."
        },
        {
          "id": 68,
          "timecode": "00:03:53,600 --> 00:03:57,100",
          "text": "And at last, everyone turned toward Italy's waiting scorecard."
        },
        {
          "id": 69,
          "timecode": "00:03:57,100 --> 00:04:00,600",
          "text": "Its judges loved the combination of taste, nutrition, and satisfaction."
        },
        {
          "id": 70,
          "timecode": "00:04:00,600 --> 00:04:04,100",
          "text": "Italy won their challenge with a massive eighty-six points."
        },
        {
          "id": 71,
          "timecode": "00:04:04,100 --> 00:04:07,600",
          "text": "Apparently, a plate of pasta can make school seem exciting."
        },
        {
          "id": 72,
          "timecode": "00:04:07,600 --> 00:04:11,050",
          "text": "At least that's what these three very hungry judges decided."
        }
      ],
