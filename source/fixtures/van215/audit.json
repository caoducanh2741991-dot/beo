    {
      "name": "van 6",
      "sha256": "88fdd77c73859b097e31637aaa74323426ecfcf4513d45fbd81379e852fbfb3f",
      "cues": [
        {
          "id": 1,
          "timecode": "00:00:00,000 --> 00:00:03,600",
          "text": "Would you hang a giant ham upstairs to avoid a luxury price?"
        },
        {
          "id": 2,
          "timecode": "00:00:03,600 --> 00:00:07,200",
          "text": "Vance thought twelve thousand dollars for Spanish ham was outrageous."
        },
        {
          "id": 3,
          "timecode": "00:00:07,200 --> 00:00:10,800",
          "text": "Instead of buying expensive slices, he imagined making one himself."
        },
        {
          "id": 4,
          "timecode": "00:00:10,800 --> 00:00:14,400",
          "text": "And somehow, his ordinary attic became part of that plan."
        },
        {
          "id": 5,
          "timecode": "00:00:14,400 --> 00:00:18,000",
          "text": "First, he ignored the glamorous gourmet shop displays entirely."
        },
        {
          "id": 6,
          "timecode": "00:00:18,000 --> 00:00:21,600",
          "text": "He headed to the local market with a very different budget."
        },
        {
          "id": 7,
          "timecode": "00:00:21,600 --> 00:00:25,200",
          "text": "The enormous pork leg he carried home looked almost unreal."
        },
        {
          "id": 8,
          "timecode": "00:00:25,200 --> 00:00:28,800",
          "text": "But Vance knew buying it was just the beginning."
        },
        {
          "id": 9,
          "timecode": "00:00:28,800 --> 00:00:32,400",
          "text": "He weighed the massive cut, already imagining the final result."
        },
        {
          "id": 10,
          "timecode": "00:00:32,400 --> 00:00:36,000",
          "text": "Soon the kitchen counter looked more like an unusual experiment."
        },
        {
          "id": 11,
          "timecode": "00:00:36,000 --> 00:00:39,600",
          "text": "The mountain of salt alone made the whole project look absurd."
        },
        {
          "id": 12,
          "timecode": "00:00:39,600 --> 00:00:43,200",
          "text": "Still, his grocery receipt was nothing like the boutique price."
        },
        {
          "id": 13,
          "timecode": "00:00:43,200 --> 00:00:46,800",
          "text": "Then a bright red wooden chest appeared in the backyard."
        },
        {
          "id": 14,
          "timecode": "00:00:46,800 --> 00:00:50,400",
          "text": "Neighbors probably had questions, but Vance wasn't giving explanations."
        },
        {
          "id": 15,
          "timecode": "00:00:50,400 --> 00:00:54,000",
          "text": "Days passed, and the yard slowly changed with the seasons."
        },
        {
          "id": 16,
          "timecode": "00:00:54,000 --> 00:00:57,600",
          "text": "After three long weeks, he finally opened the strange chest."
        },
        {
          "id": 17,
          "timecode": "00:00:57,600 --> 00:01:01,200",
          "text": "What emerged looked surprisingly different from the meat he started with."
        },
        {
          "id": 18,
          "timecode": "00:01:01,200 --> 00:01:04,800",
          "text": "Vance and his friend could barely lift the enormous leg."
        },
        {
          "id": 19,
          "timecode": "00:01:04,800 --> 00:01:08,400",
          "text": "But the strangest part of his experiment was still ahead."
        },
        {
          "id": 20,
          "timecode": "00:01:08,400 --> 00:01:12,000",
          "text": "He carried that giant ham upstairs into his attic."
        },
        {
          "id": 21,
          "timecode": "00:01:12,000 --> 00:01:15,600",
          "text": "The empty room suddenly had a very unusual new resident."
        },
        {
          "id": 22,
          "timecode": "00:01:15,600 --> 00:01:19,200",
          "text": "Even Vance had to laugh at his bizarre home setup."
        },
        {
          "id": 23,
          "timecode": "00:01:19,200 --> 00:01:22,800",
          "text": "He hoped this space could resemble an old European curing cellar."
        },
        {
          "id": 24,
          "timecode": "00:01:22,800 --> 00:01:26,400",
          "text": "But months of waiting would test his patience more than anything."
        },
        {
          "id": 25,
          "timecode": "00:01:26,400 --> 00:01:30,000",
          "text": "A giant piece of meat hanging upstairs looked risky to outsiders."
        },
        {
          "id": 26,
          "timecode": "00:01:30,000 --> 00:01:33,600",
          "text": "And a homemade setup is no guarantee that food stays safe."
        },
        {
          "id": 27,
          "timecode": "00:01:33,600 --> 00:01:37,200",
          "text": "Still, Vance kept returning to check on his unusual project."
        },
        {
          "id": 28,
          "timecode": "00:01:37,200 --> 00:01:40,800",
          "text": "The hanging ham gradually took on an almost cake-like white coating."
        },
        {
          "id": 29,
          "timecode": "00:01:40,800 --> 00:01:44,400",
          "text": "After more waiting, the moment of truth finally arrived."
        },
        {
          "id": 30,
          "timecode": "00:01:44,400 --> 00:01:48,000",
          "text": "Vance inspected the ham with the focus of a nervous contestant."
        },
        {
          "id": 31,
          "timecode": "00:01:48,000 --> 00:01:51,600",
          "text": "He seemed convinced the enormous gamble had finally worked."
        },
        {
          "id": 32,
          "timecode": "00:01:51,600 --> 00:01:55,200",
          "text": "So he carried his prize downstairs for the big reveal."
        },
        {
          "id": 33,
          "timecode": "00:01:55,200 --> 00:01:58,800",
          "text": "The giant leg took center stage on its wooden stand."
        },
        {
          "id": 34,
          "timecode": "00:01:58,800 --> 00:02:02,400",
          "text": "Almost two months of waiting had led to this moment."
        },
        {
          "id": 35,
          "timecode": "00:02:02,400 --> 00:02:06,000",
          "text": "The first exposed slice showed a surprisingly deep red color."
        },
        {
          "id": 36,
          "timecode": "00:02:06,000 --> 00:02:09,600",
          "text": "It looked remarkably similar to the ham behind gourmet counters."
        },
        {
          "id": 37,
          "timecode": "00:02:09,600 --> 00:02:13,200",
          "text": "Vance shaved off thin ribbons as everyone watched closely."
        },
        {
          "id": 38,
          "timecode": "00:02:13,200 --> 00:02:16,800",
          "text": "Then he finally tasted the result of his long experiment."
        },
        {
          "id": 39,
          "timecode": "00:02:16,800 --> 00:02:20,400",
          "text": "His reaction suggested he loved the rich, salty flavor."
        },
        {
          "id": 40,
          "timecode": "00:02:20,400 --> 00:02:24,000",
          "text": "A little cheese and a crunchy cracker completed his tasting plate."
        },
        {
          "id": 41,
          "timecode": "00:02:24,000 --> 00:02:27,500",
          "text": "Then came the final question: how much had he spent?"
        },
        {
          "id": 42,
          "timecode": "00:02:27,500 --> 00:02:31,000",
          "text": "Vance counted about three hundred fifty dollars for the project."
        },
        {
          "id": 43,
          "timecode": "00:02:31,000 --> 00:02:34,500",
          "text": "Against that boutique price tag, the difference looked enormous."
        },
        {
          "id": 44,
          "timecode": "00:02:34,500 --> 00:02:37,991",
          "text": "But would you trust a homemade attic ham? That's the debate."
        }
